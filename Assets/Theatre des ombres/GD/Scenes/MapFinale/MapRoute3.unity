    - target: {fileID: 4008081496005786401, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_LocalRotation.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4008081496005786401, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_LocalRotation.z
      value: 0
