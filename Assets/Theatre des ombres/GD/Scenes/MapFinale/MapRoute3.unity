    - target: {fileID: 4008081496005786401, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4008081496005786401, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: displayTime
      value: 0.9
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: dialogueTextUI
      value: 
      objectReference: {fileID: 1957495250}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: typewriterDelay
      value: 0.042
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: branch12.Array.size
      value: 49
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[0]'
      value: "Il \xE9tait une fois dans la fausse for\xEAt de Korha,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[1]'
      value: "une jeune \xE2me s\u2019avan\xE7ant d\xE9termin\xE9e vers le ch\xE2teau,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[2]'
      value: "qui se dressait alors fi\xE8rement sur la colline."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[3]'
      value: "Mais ainsi, ce vaillant personnage qui s\u2019appr\xEAtait \xE0 braver
        vents et mar\xE9es pour accomplir son objectif n\u2019\xE9tait autre que..."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[4]'
      value: La Chevaleresse Lyra,
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[5]'
      value: "Une des guerri\xE8res les plus courageuses de la contr\xE9e, "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[6]'
      value: "avait \xE9t\xE9 envoy\xE9e par le roi afin de r\xE9aliser une t\xE2che
        de la plus haute importance."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[7]'
      value: "Seulement, alors qu\u2019elle s\u2019appr\xEAtait \xE0 quitter la vaste
        for\xEAt afin de retourner aupr\xE8s de son roi, "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[8]'
      value: "un groupe de bandits malfam\xE9s jaillit face \xE0 elle."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[9]'
      value: "Et malgr\xE9 son courage et sa t\xE9nacit\xE9, elle ne put rien faire
        face \xE0 leur nombre."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[10]'
      value: "Ces derniers prenant un malin plaisir \xE0 la d\xE9pouiller de ses
        biens,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[11]'
      value: "la privant de son attirail de chevaleresse en lui subtilisant son \xE9p\xE9e
        ainsi que son bouclier,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[12]'
      value: "avant de dispara\xEEtre dans la for\xEAt."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[13]'
      value: "Ainsi humili\xE9e, il lui incombait \xE0 pr\xE9sent de se r\xE9\xE9quiper
        afin de retourner,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[14]'
      value: "digne, au ch\xE2teau."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[15]'
      value: "Malgr\xE9 ces mauvaises rencontres,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[16]'
      value: "cela n\u2019avait pas d\xE9courag\xE9 pour autant notre personnage
        dans sa qu\xEAte, qui \xE9tait enfin parvenu \xE0 quitter la for\xEAt."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[17]'
      value: "Laissant \xE0 pr\xE9sent se d\xE9voiler devant lui un petit village."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[18]'
      value: "Et \xE0 peine arriv\xE9, ce dernier fut directement attir\xE9 par le
        son des mart\xE8lements r\xE9p\xE9t\xE9s, le menant \xE0 la forge du village,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[19]'
      value: "qui, curieux de savoir ce qu\u2019il pouvait bien se procurer, interpella
        le forgeron afin de lui demander... "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[20]'
      value: Un bouclier.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[21]'
      value: Elle qui avait tout juste assez pour se procurer une arme opta ainsi
        pour le bouclier,
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[22]'
      value: "pr\xE9f\xE9rant assurer sa d\xE9fense plut\xF4t que de compter uniquement
        sur sa force brute."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[23]'
      value: "Elle r\xE9cup\xE9ra ainsi sa bourse, et donna la somme r\xE9clam\xE9e
        par le forgeron."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[24]'
      value: "Une fois le bouclier entre ses mains, elle se sentit \xE0 nouveau compl\xE8te,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[25]'
      value: "et put ainsi repartir sereine en direction du ch\xE2teau."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[26]'
      value: "\xC0 pr\xE9sent \xE9quip\xE9 et par\xE9, notre personnage put enfin
        entamer la derni\xE8re \xE9tape de son p\xE9riple, en entreprenant la mont\xE9e
        de la colline menant au ch\xE2teau."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[27]'
      value: "Et ainsi, au fur et \xE0 mesure de son avanc\xE9e,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[28]'
      value: les tours semblaient se dresser majestueusement devant lui.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[29]'
      value: "Mais alors qu\u2019il se trouvait \xE0 pr\xE9sent \xE0 deux pas de
        la porte du ch\xE2teau, il aper\xE7ut une silhouette."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[30]'
      value: ' Celle...'
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[31]'
      value: Du Roi
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[32]'
      value: depuis les remparts,
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[33]'
      value: "\u2014 Ah ! chevaleresse Lyra ! D\xE9j\xE0 de retour\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[34]'
      value: "Il n\u2019eut pas le temps de finir sa phrase, qu\u2019un rugissement
        terrifiant r\xE9sonna dans tout le royaume."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[35]'
      value: "Un dragon surgissant au-dessus du ch\xE2teau, et se mettant \xE0 cracher
        des flammes sur ce dernier."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[36]'
      value: "Le roi, paniqu\xE9, implora aussit\xF4t sa garde ainsi que Lyra de
        le sauver."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[37]'
      value: "Sans r\xE9fl\xE9chir, Lyra se pr\xE9cipita alors vers lui pour le prot\xE9ger."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[38]'
      value: "Mais le dragon la prit aussit\xF4t pour cible."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[39]'
      value: "Elle leva instinctivement son bouclier pour se prot\xE9ger."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[40]'
      value: "Le m\xE9tal encaissant la chaleur, mais un choc improbable s\u2019ensuivit."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[41]'
      value: 'La flamme venait de rebondir sur le bouclier, finissant tristement
        sa course sur... '
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[42]'
      value: Le roi.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[43]'
      value: "Ce dernier se changea aussit\xF4t en un tas de cendres fumantes."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[44]'
      value: Lyra, prise de panique,
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[45]'
      value: "choqu\xE9e par la situation qu'elle venait de provoquer,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[46]'
      value: "mais surtout honteuse, prit ses jambes \xE0 son cou, abandonnant le
        royaume \xE0 son sort."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[47]'
      value: "Le dragon, continuant alors de ravager les parcelles de la contr\xE9e,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[48]'
      value: "plus personne n\u2019\xE9tant capable de l\u2019arr\xEAter."
      objectReference: {fileID: 0}
    - target: {fileID: 6396734172077087262, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6629023012778266455, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_Resource
      value: 
      objectReference: {fileID: 8300000, guid: 7027e345d7e9eec40af11e32dd769de5, type: 3}
