    - target: {fileID: 4008081496005786401, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5617438370356856132, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: delayBeforeStart
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: dialogueTextUI
      value: 
      objectReference: {fileID: 96264618}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: typewriterDelay
      value: 0.042
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: branch12.Array.size
      value: 89
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[0]'
      value: "Il \xE9tait une fois dans la fausse for\xEAt de Korha,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[1]'
      value: "une jeune \xE2me s\u2019avan\xE7ant d\xE9termin\xE9e vers le ch\xE2teau,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[2]'
      value: "qui se dressait alors fi\xE8rement sur la colline."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[3]'
      value: "Mais ainsi, ce vaillant personnage qui s\u2019appr\xEAtait \xE0 braver
        vents et mar\xE9es pour accomplir son objectif n\u2019\xE9tait autre que..."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[4]'
      value: Le Roi.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[5]'
      value: "Connu pour \xEAtre fid\xE8le \xE0 lui-m\xEAme, avait quitt\xE9 le ch\xE2teau
        pour une partie de chasse. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[6]'
      value: "Il s\u2019\xE9tait imprudemment \xE9loign\xE9 de sa garde rapproch\xE9e,
        d\xE9cid\xE9 \xE0 mener la traque \u201Ctel un h\xE9ros\u201D."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[7]'
      value: "Seulement, ce fut \xE0 ce moment-l\xE0 qu\u2019une horde de bandits
        malfam\xE9s jaillit face \xE0 lui."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[8]'
      value: "Malgr\xE9 son attitude fanfaronne, il ne put rien faire face \xE0 leur
        nombre,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[9]'
      value: "ces derniers le d\xE9pouillant de ses attributs :"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[10]'
      value: "lui arrachant armes, bijoux et sa couronne ador\xE9e,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[11]'
      value: "avant de dispara\xEEtre dans la for\xEAt."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[12]'
      value: "Ainsi, sale et humili\xE9, il se retrouva seul, sans gardes."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[13]'
      value: "Il lui fallait donc vite retourner au ch\xE2teau afin de retrouver
        la protection de ses chevaliers,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[14]'
      value: et regagner sa place de roi.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[15]'
      value: "Malgr\xE9 ces mauvaises rencontres,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[16]'
      value: "cela n\u2019avait pas d\xE9courag\xE9 pour autant notre personnage
        dans sa qu\xEAte, qui \xE9tait enfin parvenu \xE0 quitter la for\xEAt."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[17]'
      value: "Laissant \xE0 pr\xE9sent se d\xE9voiler devant lui un petit village."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[18]'
      value: "Et \xE0 peine arriv\xE9, ce dernier fut directement attir\xE9 par le
        son des mart\xE8lements r\xE9p\xE9t\xE9s,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[19]'
      value: "le menant \xE0 la forge du village, qui, curieux de savoir ce qu\u2019il
        pouvait bien se procurer, interpella le forgeron afin de lui demander..."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[20]'
      value: Un bouclier.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[21]'
      value: "Demanda fi\xE8rement ce dernier, alors qu\u2019il n\u2019avait jamais
        tenu une seule arme de sa vie."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[22]'
      value: "\u2014 Cela vous fera 10 \xE9cus, d\xE9clara le forgeron."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[23]'
      value: "Le roi se mit \xE0 ricaner, persuad\xE9 que l\u2019homme le reconna\xEEtrait
        aussit\xF4t."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[24]'
      value: "Mais le forgeron, le d\xE9visageant sans comprendre, lui demanda de
        prouver son identit\xE9."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[25]'
      value: "Il d\xE9clara avec fiert\xE9 qu\u2019il connaissait tr\xE8s bien son
        roi et qu\u2019il n\u2019avait \u201Crien en commun\u201D avec lui,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[26]'
      value: "ce qui acheva de d\xE9semparer son Altesse, d\xE9j\xE0 sans le moindre
        sou en poche."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[27]'
      value: "Il tenta alors une approche qu\u2019il n\u2019aurait jamais faite en
        tant que roi. Il se mit \xE0 crier de toutes ses forces : "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[28]'
      value: "\u2014 Mon brave homme, un squelette s\u2019approche de votre forge
        !"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[29]'
      value: "Vite, je sais me battre comme un roi, donnez-moi ce bouclier pour vous
        prot\xE9ger ! "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[30]'
      value: "Le forgeron sursauta, paniqu\xE9, regardant dans la direction indiqu\xE9e
        par le roi,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[31]'
      value: "laissant le champ libre \xE0 ce dernier pour subtiliser le bouclier
        expos\xE9 avant de se pr\xE9cipiter hors de la forge, puis du village."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[32]'
      value: "Il poursuivit ainsi sa route vers le ch\xE2teau, laissant le forgeron
        dans l\u2019incompr\xE9hension la plus totale suite \xE0 ce qu\u2019il venait
        de se passer."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[33]'
      value: "\xC0 pr\xE9sent \xE9quip\xE9 et par\xE9, notre personnage put enfin
        entamer la derni\xE8re \xE9tape de son p\xE9riple,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[34]'
      value: "en entreprenant la mont\xE9e de la colline menant au ch\xE2teau."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[35]'
      value: "Et ainsi, au fur et \xE0 mesure de son avanc\xE9e, les tours semblaient
        se dresser majestueusement devant lui."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[36]'
      value: "Mais alors qu\u2019il se trouvait \xE0 pr\xE9sent \xE0 deux pas de
        la porte du ch\xE2teau, il aper\xE7ut une silhouette,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[37]'
      value: Celle...
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[38]'
      value: D'un Squelette.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[39]'
      value: "Post\xE9 non loin des murailles du ch\xE2teau, il observait le roi
        \xE9puis\xE9, qui se dirigeait vers l\u2019entr\xE9e gard\xE9e par une chevaleresse."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[40]'
      value: "Le roi s\u2019arr\xEAta devant la porte du ch\xE2teau, et interpella
        la garde :"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[41]'
      value: "\u2014 Eh oh, toi ! Ouvre la porte \xE0 ton roi !"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[42]'
      value: "La garde le d\xE9visagea,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[43]'
      value: "perplexe, puis \xE9clata de rire. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[44]'
      value: "\u2014 Ton roi ? De qui tu parles, mendiant ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[45]'
      value: "D\xE9guerpis avant qu\u2019on te chasse \xE0 coups de hallebarde."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[46]'
      value: "\u2014 Comment oses-tu parler \xE0 ton roi sur ce ton ? Je te ferai
        fouetter pour \xE7a !"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[47]'
      value: "\xC0 ces mots, plusieurs gardes sortirent du ch\xE2teau,"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[48]'
      value: "le saisirent sans m\xE9nagement et l\u2019\xE9loign\xE8rent de l\u2019entr\xE9e
        comme un simple vagabond."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[49]'
      value: "Rejet\xE9 et humili\xE9, il resta seul, \xE0 se morfondre."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[50]'
      value: "\xC9tait-il devenu fou ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[51]'
      value: "Le royaume avait-il oubli\xE9 son propre souverain ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[52]'
      value: "C\u2019est alors qu\u2019un squelette surgit du chemin, marchant d\u2019un
        pas tranquille."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[53]'
      value: "Le roi resta bouche b\xE9e."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[54]'
      value: "Le mort-vivant l\u2019observa un instant puis demanda :"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[55]'
      value: "\u2014 Toi aussi, ils t\u2019ont refus\xE9 l\u2019entr\xE9e du ch\xE2teau
        ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[56]'
      value: "\u2014 Oui\u2026 ils ne me reconnaissent pas..."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[57]'
      value: Je suis le roi.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[58]'
      value: "Le squelette secoua sa bo\xEEte cr\xE2nienne, amus\xE9. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[59]'
      value: "\u2014 Oui, bien s\xFBr. Et moi, je suis vivant."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[60]'
      value: "Il tr\xE9bucha sur une pierre, manquant de s\u2019effondrer en morceaux. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[61]'
      value: "\u2014 Ah tiens\u2026 je crois que j\u2019ai perdu un os."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[62]'
      value: "\u2014 \xC7a suffit, grogna le roi. Je suis d\xE9j\xE0 assez ridicule
        comme \xE7a."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[63]'
      value: "Un silence s\u2019installa quelques secondes."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[64]'
      value: 'Puis le squelette reprit :'
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[65]'
      value: "\u2014 D\xE9sol\xE9. Alors\u2026 que comptes-tu faire maintenant ?"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[66]'
      value: "Le roi baissa la t\xEAte."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[67]'
      value: "\u2014 Je ne sais pas. Peut-\xEAtre qu\u2019il est temps d\u2019en
        finir avec\u2026 tout \xE7a."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[68]'
      value: "Avec la royaut\xE9, le pouvoir\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[69]'
      value: "Les responsabilit\xE9s que plus personne ne voit."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[70]'
      value: "Le squelette se rapprocha de lui, geste \xE9trange pour une cr\xE9ature
        sans chair. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[71]'
      value: "\u2014 Tu sais\u2026 on est pareils, toi et moi."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[72]'
      value: "On a \xE9t\xE9 oubli\xE9s. Mis de c\xF4t\xE9. Effac\xE9s."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[73]'
      value: Il tendit une main osseuse.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[74]'
      value: "\u2014 Alors fuis avec moi."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[75]'
      value: Quittons ces murs, quittons leurs jugements.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[76]'
      value: "Partons vers l\u2019horizon."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[77]'
      value: Juste toi et moi.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[78]'
      value: Sans se retourner.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[79]'
      value: Le roi regarda cette main blanche,
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[80]'
      value: fragile, incongrue.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[81]'
      value: "Et pour la premi\xE8re fois depuis longtemps\u2026 il sourit."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[82]'
      value: Il posa sa main dans celle du squelette.
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[83]'
      value: "\u2014 Tr\xE8s bien. Ensemble, alors."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[84]'
      value: "Et tous deux partirent sur la route, c\xF4te \xE0 c\xF4te."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[85]'
      value: "Un roi d\xE9chu et un mort-vivant sarcastique. "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[86]'
      value: "On raconta qu\u2019ils travers\xE8rent montagnes et for\xEAts, qu\u2019ils
        se li\xE8rent d\u2019une amiti\xE9 ou peut-\xEAtre d\u2019un amour que nul
        ne peut s\xE9parer."
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[87]'
      value: "Et que jamais plus ils ne cherch\xE8rent \xE0 revenir au ch\xE2teau.
        Car parfois, la libert\xE9 n\u2019est pas un tr\xF4ne\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 5940439431317087825, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: 'branch12.Array.data[88]'
      value: "Mais simplement quelqu\u2019un qui vous tend la main, quand tout le
        monde vous oublie."
      objectReference: {fileID: 0}
    - target: {fileID: 6629023012778266455, guid: a626a0850a91ac742940f13c78252877, type: 3}
      propertyPath: m_Resource
      value: 
      objectReference: {fileID: 8300000, guid: a86b5ad828d5ab3468fae5fc19d67722, type: 3}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
